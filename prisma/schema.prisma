// Prisma schema — mirrors the shapes in src/types/*.ts exactly (same field
// names/types) so the service-layer rewrite (localStorage -> API routes) is
// mechanical. Scalar id-array fields (assigneeIds, teamIds, ...) use native
// Postgres arrays rather than join tables, matching today's data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
  member_limited
  viewer
  // Full admin control plus the Salaires (payroll) section of Biométrie,
  // which even a regular admin can no longer see or edit. Deliberately
  // meant for exactly one account (see SUPER_ADMIN_USER_ID in
  // roleMeta.ts), enforced server-side in the user-role PATCH route, not
  // just left as a UI convention.
  super_admin
}

enum UserStatus {
  active
  disabled
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  passwordHash        String
  role                Role
  color               String
  photoDataUrl        String?
  status              UserStatus @default(active)
  managerIds          String[]   @default([])
  // string[] | null in the app — null means "no admin restriction, sees
  // everything". Prisma arrays can't be nullable, so this is stored as Json
  // (either a JSON array of strings, or JSON null) instead of String[]?.
  visibleSectionHrefs Json?
  // Hrefs an admin has explicitly granted this user beyond what their role
  // would normally include — currently only meaningful for /calls and
  // /biometrie, which are otherwise gated to the admin/member roles. Always
  // a plain array (no "null means no restriction" case like
  // visibleSectionHrefs above, since this only ever adds, never narrows).
  extraSectionHrefs   String[]   @default([])
  hiddenColumnIds     String[]   @default([])
  // AI agent "employee" account — never logs in with a password, excluded
  // from assignee pickers, has an AgentConfig row with its persona/tools.
  isAgent             Boolean    @default(false)
  createdAt           DateTime   @default(now())

  pushSubscriptions               PushSubscription[]
  agentConfig                     AgentConfig?
  callFilterViews                 CallFilterView[]
  agentMemories                   AgentMemory[]
  agentReportSchedulesAsAgent     AgentReportSchedule[] @relation("AgentReportScheduleAgent")
  agentReportSchedulesAsRecipient AgentReportSchedule[] @relation("AgentReportScheduleRecipient")

  @@map("users")
}

model Team {
  id               String   @id @default(cuid())
  name             String
  color            String
  memberIds        String[] @default([])
  excludedUserIds  String[] @default([])
  createdAt        DateTime @default(now())

  @@map("teams")
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String
  color           String
  logoDataUrl     String?
  teamIds         String[] @default([])
  excludedUserIds String[] @default([])
  createdAt       DateTime @default(now())

  tasks Task[]

  @@map("projects")
}

enum TaskModule {
  task
  dispute
}

model Task {
  id                 String     @id @default(cuid())
  module             TaskModule
  title              String
  description        String     @default("")
  status             String
  priority           String
  assigneeIds        String[]   @default([])
  teamIds            String[]   @default([])
  excludedUserIds    String[]   @default([])
  startDate          DateTime?
  dueDate            DateTime?
  recurrence         Json?
  order              Float
  customValues       Json       @default("{}")
  // Non-admins get full edit rights only on tasks they created themselves
  // (see src/lib/taskPermissions.ts); null on tasks that predate this column.
  createdBy          String?
  recurrenceSourceId String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  parentId String?
  parent   Task?   @relation("TaskParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]  @relation("TaskParent")

  recurrenceSource Task? @relation("TaskRecurrence", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceNext   Task? @relation("TaskRecurrence")

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

enum CustomFieldType {
  text
  number
  date
  select
  image
  video
  link
}

model CustomFieldDef {
  id        String          @id @default(cuid())
  name      String
  type      CustomFieldType
  options   Json            @default("[]")
  order     Int
  createdAt DateTime        @default(now())

  @@map("custom_fields")
}

model StatusDef {
  id    String @id @default(cuid())
  label String
  color String
  order Int

  @@map("statuses")
}

model PriorityDef {
  id    String @id @default(cuid())
  label String
  color String
  order Int

  @@map("priorities")
}

enum PurchaseColumnType {
  text
  number
  dropdown
  image
  video
  link
  date
}

model PurchaseColumnDef {
  id        String             @id @default(cuid())
  name      String
  type      PurchaseColumnType
  options   Json               @default("[]")
  order     Int
  createdAt DateTime           @default(now())

  @@map("purchase_columns")
}

model PurchaseItem {
  id              String   @id @default(cuid())
  order           Float
  values          Json     @default("{}")
  assigneeIds     String[] @default([])
  excludedUserIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("purchase_items")
}

enum ConversationType {
  direct
  group
}

model Conversation {
  id                  String           @id @default(cuid())
  type                ConversationType
  name                String?
  participantIds      String[]         @default([])
  avatarDataUrl       String?
  createdBy           String
  createdAt           DateTime         @default(now())
  lastMessageAt       DateTime         @default(now())
  lastMessagePreview  String?
  lastReadAt          Json             @default("{}")
  // Ids of agent participants currently composing a reply (fire-and-forget
  // OpenAI round-trip) — polled by the client to show a "typing…" bubble.
  typingAgentIds      String[]         @default([])

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String       @default("")
  attachments    Json         @default("[]")
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  // Soft-delete: the row stays (so the thread doesn't reflow) with text/
  // attachments cleared and this timestamp set as a tombstone marker.
  deletedAt      DateTime?

  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

enum AgentKind {
  internal
  external
}

model AgentConfig {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             AgentKind
  systemPrompt     String
  // "tasks","litiges","achats","projects","teams","library","reminders","biometric","calls","email","telegram","whatsapp","websearch","gmail","drive","n8n"
  enabledTools     String[]  @default([])
  // Every Telegram chat currently linked to this agent — multiple people can
  // talk to the same agent (shared conversation/context), not just one.
  telegramChatIds  String[]  @default([])
  telegramLinkCode String?
  // Same idea as telegramChatIds/telegramLinkCode above, but for WhatsApp —
  // every contact's WhatsApp number ("wa_id") currently linked to this
  // agent via the /link <code> flow, one shared WhatsApp Business number
  // routing to whichever agent each sender is linked to.
  whatsappChatIds  String[]  @default([])
  whatsappLinkCode String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("agent_configs")
}

// A standing fact/instruction this agent has learned or been given — either
// self-written (via the remember/forget tools, as it learns things during
// conversations) or admin-written directly in AgentFormDialog. Injected
// into the system prompt on every turn as something the agent must
// actually respect, not just background trivia — the equivalent of
// per-agent long-term memory, since chat history alone only covers the
// current conversation's last 30 messages.
model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@map("agent_memories")
}

// A recurring report an agent sends to one specific person via chat, at
// one or more fixed times each day (Casablanca time) — e.g. "send Elmehdi
// the unhandled-missed-calls and today's biometric report at 10:30 and
// 20:30". Deliberately narrow (a fixed pair of report types) rather than a
// generic scheduled-action framework — AgentSchedule below was built for
// that but never wired up (no cron route, no actionType contract, no
// creation path); this solves the one concrete need it was meant for
// instead of finishing that speculative generality.
model AgentReportSchedule {
  id          String    @id @default(cuid())
  agentId     String
  agent       User      @relation("AgentReportScheduleAgent", fields: [agentId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("AgentReportScheduleRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  timesOfDay  String[]  @default([]) // "HH:mm", Casablanca time
  reportTypes String[]  @default([]) // "calls_unhandled" | "biometric_today"
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("agent_report_schedules")
}

model AgentSchedule {
  id              String    @id @default(cuid())
  agentId         String
  instructionText String
  cronExpression  String
  actionType      String
  actionConfig    Json      @default("{}")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())

  @@map("agent_schedules")
}

model ReminderRule {
  id    String  @id @default(cuid())
  name  String
  // "overdue_escalation" | "meeting"
  kind    String
  enabled Boolean @default(true)

  // overdue_escalation config
  timesOfDay     String[] @default([]) // "HH:mm", Africa/Casablanca local time
  notifyAssignee Boolean  @default(true)
  notifyManager  Boolean  @default(true)

  // meeting config (one-shot: fires once, not recurring)
  meetingAt       DateTime?
  minutesBefore   Int?
  wholeTeam       Boolean   @default(false)
  audienceUserIds String[]  @default([])
  audienceTeamIds String[]  @default([])

  // delivery
  viaPush      Boolean @default(true)
  viaAgentChat Boolean @default(true)
  agentId      String?

  lastRunAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reminder_rules")
}

model GoogleConnection {
  id           String   @id @default(cuid())
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String[]
  connectedBy  String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_connections")
}

model AdProject {
  id              String    @id @default(cuid())
  name            String
  client          String
  platform        String
  status          String
  archived        Boolean   @default(false)
  startDate       DateTime?
  endDate         DateTime?
  totalBudget     Float
  // Set once an admin links this project to a Meta ad account (act_...), enabling auto-sync.
  metaAdAccountId String?
  createdAt       DateTime  @default(now())

  @@map("ad_projects")
}

model AdCampaign {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  platform     String
  objective    String
  status       String
  budget       Float
  amountSpent  Float
  results      Int
  revenue      Float
  reach        Int
  impressions  Int
  clicks       Int
  // "manual" | "meta" — synced rows are read-only in the UI and overwritten on each sync.
  source       String    @default("manual")
  externalId   String?
  lastSyncedAt DateTime?
  // Flexible bag of extra Meta-reported KPIs (cpc, cpm, ctr, linkClicks,
  // deliveryStatus, etc.) — a JSON blob rather than one column per metric
  // so new Meta KPIs can be added by extending the fetch list, not a migration.
  metaInsights Json?
  createdAt    DateTime  @default(now())

  @@unique([projectId, externalId])
  @@map("ad_campaigns")
}

model MetaConnection {
  id          String   @id @default(cuid())
  accountName String
  accessToken String
  expiresAt   DateTime
  connectedBy String
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("meta_connections")
}

model AgentActionLog {
  id        String   @id @default(cuid())
  agentId   String
  type      String
  summary   String
  payload   Json?
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@map("agent_action_logs")
}

model AgentIntegration {
  id          String    @id @default(cuid())
  agentId     String
  provider    String
  credentials Json
  status      String    @default("disconnected")
  connectedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([agentId, provider])
  @@map("agent_integrations")
}

model LibraryDoc {
  id        String   @id @default(cuid())
  title     String
  // Markdown — readable for humans (rendered) and directly usable as plain-text context for AI agents.
  content   String   @default("")
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("library_docs")
}

// Task-level file/link attachments. `url` points at Supabase Storage (or is
// null for link-kind attachments, which use linkUrl instead).
model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  name       String
  kind       String
  mimeType   String
  sizeBytes  Int
  url        String?
  linkUrl    String?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("attachments")
}

model ArchivedItem {
  id         String    @id @default(cuid())
  module     String
  originalId String
  title      String
  archivedAt DateTime  @default(now())
  archivedBy String
  // Path to the full serialized payload in Supabase Storage — deliberately
  // not stored here, so archiving actually shrinks the database.
  storageKey String
  // Groups every item created by one "Archive" click so the UI can show
  // one row per archive run instead of one per task/conversation/item.
  batchId    String

  @@index([batchId])
  @@map("archived_items")
}

// Links the app to a Google Sheet used as an off-site backup for
// Tasks/Litiges/Achats (single row — same singleton pattern as
// GoogleConnection/MetaConnection).
model BackupSheetConfig {
  id               String    @id @default(cuid())
  spreadsheetId    String
  spreadsheetTitle String?
  lastBackupAt     DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("backup_sheet_config")
}

// Pulled on demand from 3CX's XAPI (Pbx.GetCallLogData) via a manual
// "Synchroniser" sync — not written directly by 3CX like the earlier
// Call Journaling approach (which never fired in practice, blocked by an
// expired 3CX license). externalId is 3CX's own CdrId, used as the
// upsert key so repeated syncs update rather than duplicate.
model PhoneCall {
  id           Int      @id @default(autoincrement())
  externalId   String   @unique // 3CX CdrId
  startTime    DateTime
  sourceNumber String // SourceCallerId
  sourceName   String? // SourceDisplayName
  sourceDn     String   @default("") // SourceDn — the internal extension, if any (empty for a raw external caller)
  destNumber   String // DestinationCallerId
  destName     String? // DestinationDisplayName
  destDn       String   @default("") // DestinationDn — often the real internal extension even when DestinationCallerId is blank (e.g. inbound external calls)
  direction    String // Inbound | Outbound | Internal
  status       String // Answered | Missed | ... (whatever 3CX returns)
  answered     Boolean
  ringSeconds  Int      @default(0) // parsed from RingingDuration ("PT7.8S")
  talkSeconds  Int      @default(0) // parsed from TalkingDuration
  cost         Float    @default(0)
  reason       String?
  createdAt    DateTime @default(now())

  @@map("phone_calls")
}

// A user's own saved filter combination for the Calls page (search/status/
// direction/date/time/user), so a view they use often doesn't need
// rebuilding by hand every visit — private per-user, not shared org-wide.
model CallFilterView {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  search            String   @default("")
  statusFilter      String[] @default([])
  directionFilter   String[] @default([])
  dateFrom          String   @default("")
  dateTo            String   @default("")
  dateRangeLabel    String   @default("Toutes les dates")
  timeFrom          String   @default("")
  timeTo            String   @default("")
  businessHoursOnly Boolean  @default(false)
  timeRangeLabel    String   @default("Toute la journée")
  selectedUserDn    String?
  unhandledOnly     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@map("call_filter_views")
}

// Single shared 3CX connection (like GoogleConnection/MetaConnection).
// Confirmed live (captured the real 3CX web client's own token request via
// DevTools) that 3CX's XAPI actually uses grant_type=password with the
// fixed public client_id "Webclient" for login, then grant_type=refresh_token
// (also client_id=Webclient) to renew — not client_credentials as an
// earlier community example suggested. Username/password are still stored
// so a lost/invalid refresh token can re-login without the admin
// re-entering credentials — setup recommends a dedicated low-privilege
// 3CX user instead of a personal admin login regardless.
model ThreeCxConnection {
  id             String    @id @default(cuid())
  pbxUrl         String
  username       String
  password       String
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  connectedBy    String
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("threecx_connections")
}

// Per-extension overrides layered onto the internal users auto-derived
// from synced call data (deriveInternalUsers in callStats.ts) — lets the
// display name/color be customized and lets a stray/former extension be
// hidden from the picker and charts without touching the underlying call
// history. Keyed by 3CX's DN (extension), not a generated id, since the
// "identity" here is the extension itself.
model ThreeCxUser {
  dn        String   @id
  // Admin-chosen display name override — takes precedence over realName
  // when set.
  name      String?
  // The extension's actual current name in 3CX (Users.DisplayName via
  // XAPI, confirmed live: e.g. "Standrad ( F.KAWTAR )") — refreshed on
  // every calls sync, independent of call history. Previously the app only
  // ever derived a name from whatever happened to appear in past call
  // records, which could be stale (extension renamed since its last call)
  // or a queue name instead of a person's.
  realName  String?
  color     String?
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("threecx_users")
}

// The biometric (fingerprint) clock server sits on a private LAN Hostinger
// can't reach, so there's no stored connection here — an unattended script
// on a machine inside that LAN logs into ZKBio Time itself and pushes new
// punches to POST /api/biometric/ingest (a static bearer token, not a user
// session — see BIOMETRIC_INGEST_TOKEN). externalId is the device's own
// transaction id, used as the upsert key.
model BiometricEvent {
  id              Int      @id @default(autoincrement())
  externalId      String   @unique
  empCode         String
  employeeName    String
  department      String?
  position        String?
  punchTime       DateTime
  punchState      String // raw code, e.g. "0"
  punchStateLabel String // e.g. "Check In"
  verifyType      String? // e.g. "Fingerprint"
  terminalAlias   String?
  createdAt       DateTime @default(now())

  @@map("biometric_events")
}

// Per-employee overrides layered onto the employee list pulled from
// /personnel/api/employees/ — mirrors ThreeCxUser's rename/recolor/hide
// pattern for the Calls page. Keyed by emp_code (the device's own
// employee identifier).
//
// The 5 schedule fields below let one employee's work hours differ from
// the company-wide BiometricSchedule — each is null by default, meaning
// "inherit the global value"; only the fields actually set here override
// it (see resolveEmployeeSchedule in biometricStats.ts).
model BiometricEmployeeOverride {
  empCode          String   @id
  name             String?
  color            String?
  hidden           Boolean  @default(false)
  startTime        String?
  endTime          String?
  lunchBreakStart  String?
  lunchBreakEnd    String?
  fridayBreakStart String?
  fridayBreakEnd   String?
  saturdayEndTime  String?
  // Some people simply don't work Saturdays — independent of the custom
  // work-hours override above (someone can keep the global hours and still
  // have Saturdays off). A Saturday then never counts as an absence for
  // them, see computeMonthlyAbsences.
  saturdayOff      Boolean  @default(false)
  // Gross monthly pay in DH, used by the Salaires section. Null means "not
  // set yet" (no payroll row for this employee), which is deliberately
  // distinct from 0.
  monthlySalary    Float?
  updatedAt        DateTime @updatedAt

  @@map("biometric_employee_overrides")
}

// A booked leave period for one employee (congé). Dates are "YYYY-MM-DD"
// Casablanca calendar-day strings rather than DateTime, for the same reason
// absences are keyed that way (casablancaDateKey): a leave day is a calendar
// fact, so comparing day strings avoids re-deriving a timezone from an
// instant on every read. `endDate` is inclusive — a one-day leave has
// startDate === endDate.
model BiometricLeave {
  id        String   @id @default(cuid())
  empCode   String
  startDate String
  endDate   String
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([empCode])
  @@map("biometric_leaves")
}

// A company-wide public holiday (jour ferie) — unlike BiometricLeave, this
// isn't tied to one empCode: it excuses every employee's absence and
// lateness that day, not just one person's. A single "YYYY-MM-DD" (most
// Moroccan public holidays are one day; a 2-day one like Aid gets two rows).
model BiometricHoliday {
  id        String   @id @default(cuid())
  date      String
  name      String
  createdBy String?
  createdAt DateTime @default(now())

  @@map("biometric_holidays")
}

// One row per (employee, month) for the two occasional payroll amounts
// that change every month, unlike monthlySalary/monthlyVirement on
// BiometricEmployeeOverride which stay fixed across months. `advance`
// (avance sur salaire) is money already handed out this month, so it's
// subtracted from what's still owed; `bonus` (prime) is added — see
// computePayroll for the exact Net à payer formula.
model BiometricPayrollAdjustment {
  id        String   @id @default(cuid())
  empCode   String
  monthKey  String // "YYYY-MM"
  advance   Float    @default(0)
  bonus     Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([empCode, monthKey])
  @@map("biometric_payroll_adjustments")
}

// Single shared config (singleton, same pattern as BackupSheetConfig) for
// the weekly work-hours window used both to flag late arrivals and to gate
// the Heures d'ouverture filter preset (see isWithinWorkHours in
// biometricStats.ts). Monday-Thursday and Saturday use startTime/endTime
// with a midday lunchBreakStart/End carved out; Friday uses its own
// fridayBreakStart/End (longer, for Friday prayers) instead of the lunch
// break, and its own end time via endTime; Saturday closes earlier via
// saturdayEndTime; Sunday isn't a workday.
model BiometricSchedule {
  id               String   @id @default(cuid())
  startTime        String   @default("09:30")
  endTime          String   @default("19:00")
  lunchBreakStart  String   @default("13:00")
  lunchBreakEnd    String   @default("14:00")
  fridayBreakStart String   @default("13:00")
  fridayBreakEnd   String   @default("15:00")
  saturdayEndTime  String   @default("18:00")
  updatedAt        DateTime @updatedAt

  @@map("biometric_schedule")
}

// ATELIER — motorcycle repair-shop workflow tracker. "En retard" is
// deliberately not a stored status: it's derived (expectedCompletionDate
// passed, status not yet ready/pickedUp/cancelled), same idea as Task's
// isOverdue, so nothing has to manually move a repair in/out of it.
enum WorkshopStatus {
  waiting // EN ATTENTE
  in_progress // EN COURS
  waiting_part // EN ATTENTE DE PIÈCE
  waiting_client // EN ATTENTE CLIENT
  ready // PRÊTE
  picked_up // RÉCUPÉRÉE / TERMINÉE
  cancelled // RÉSERVATION ANNULÉE

  @@map("workshop_status")
}

model WorkshopRepair {
  id                     String         @id @default(cuid())
  orderNumber            String // N° bon de commande
  brand                  String
  model                  String
  year                   Int?
  engineCc               Int?
  customerPhone          String? // internal only — never sent to the public TV route
  mechanicId             String?
  status                 WorkshopStatus @default(waiting)
  entryDate              DateTime       @default(now())
  expectedCompletionDate DateTime?
  completedDate          DateTime?
  createdBy              String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  services      WorkshopService[]
  statusHistory WorkshopStatusHistory[]

  @@map("workshop_repairs")
}

// A repair is broken into one or more concrete jobs (e.g. "Plaquettes" +
// "Pneus"), each independently scheduled/timed by the mechanic — this is
// what workDescription used to be (a single free-text field) before it
// became clear a bike can need several distinct services in parallel.
// `durationMinutes` is the estimate given at creation; `scheduledDate` is
// computed from it (see workshopScheduling.ts), never entered directly —
// each mechanic has one running queue across all their repairs, so a new
// service starts 5 minutes after that mechanic's current queue end (or at
// the repair's own entryDate if they're free). It's computed once and
// never recalculated even if the real work over/underruns the estimate.
// Lateness is judged per service against scheduledDate (see
// isWorkshopServiceLate), for internal use only — the public TV never
// sees any of this.
enum WorkshopServiceStatus {
  waiting // EN ATTENTE
  in_progress // EN COURS
  done // TERMINÉ

  @@map("workshop_service_status")
}

model WorkshopService {
  id              String                @id @default(cuid())
  repairId        String
  repair          WorkshopRepair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  description     String
  durationMinutes Int?
  scheduledDate   DateTime?
  status          WorkshopServiceStatus @default(waiting)
  completedAt     DateTime?
  order           Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  sessions WorkshopSession[]

  @@map("workshop_services")
}

// One row per continuous DÉMARRER→TERMINER chrono lifecycle for one
// service (a service can have several across its life, e.g. reopened).
// Pause/resume within that lifecycle don't create new rows — they toggle
// `runningSince` and bank the elapsed segment into `accumulatedSeconds` —
// so live elapsed time is always `accumulatedSeconds + (runningSince ? now
// - runningSince : 0)`, computed from persisted fields alone. A page
// refresh reads the same two fields and gets the same answer, which is the
// whole point: the chrono lives in the database, not in browser state.
model WorkshopSession {
  id                 String          @id @default(cuid())
  serviceId          String
  service            WorkshopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mechanicId         String
  startedAt          DateTime        @default(now())
  runningSince       DateTime? // non-null while actively counting; null while paused or after ending
  accumulatedSeconds Int             @default(0) // banked seconds from segments already paused
  pausedAt           DateTime?
  endedAt            DateTime?
  totalWorkSeconds   Int? // final total, set once when ended

  @@map("workshop_sessions")
}

model WorkshopStatusHistory {
  id         String         @id @default(cuid())
  repairId   String
  repair     WorkshopRepair @relation(fields: [repairId], references: [id], onDelete: Cascade)
  oldStatus  String?
  newStatus  String
  changedBy  String?
  changedAt  DateTime       @default(now())

  @@map("workshop_status_history")
}
